{block content}

<div class="login-page">

    <div class="login-card">

        <div class="login-logo">
            <div class="login-icon">U</div>
            <div>
                <h1>University Exam System</h1>
                <p>Univerzitní informační systém</p>
            </div>
        </div>

        <div class="login-heading">
            <h2>Přihlášení do systému</h2>
            <p>Pro pokračování zadej své přihlašovací údaje.</p>
        </div>

        {control loginForm}

        <div class="login-footer">
            University Exam System
        </div>

    </div>

</div>

{/block}